# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store

# Local environment overrides only. `.env` itself is deliberately absent from
# this list and is tracked: it carries INLINE_RUNTIME_CHUNK=false, without which
# the built site is a blank page. Anything machine-specific or sensitive goes in
# one of the .local files below, which are never committed.
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
