# THIS FILE MUST STAY IN VERSION CONTROL.
#
# It is not a secret. It is three build-time flags, and one of them is the
# difference between a working site and a blank page: without
# INLINE_RUNTIME_CHUNK=false, Create React App inlines the webpack runtime as an
# inline <script>, the `script-src 'self'` policy this project sets in
# vercel.json blocks it, and every visitor receives a blank document. The error
# boundary cannot report it, because the error boundary is inside the bundle
# that never executed.
#
# That failure has already shipped once, caused by the root .gitignore excluding
# this file from a clean clone. The root .gitignore now carries an explicit
# `!frontend/.env` negation to prevent it. Do not re-ignore this file.
#
# No secrets belong here — Create React App inlines every REACT_APP_* variable
# into the public bundle, where it is readable by anyone. Server-side
# credentials must live in the hosting platform's environment, never here.

# CRA inlines the webpack runtime into index.html by default. That inline <script>
# violates the `script-src 'self'` directive set in vercel.json. Emitting it as a
# separate file keeps the Content-Security-Policy free of 'unsafe-inline'.
INLINE_RUNTIME_CHUNK=false

# Source maps expose the full unminified source, comments and file structure of the
# application to anyone who opens devtools. Off for production builds.
GENERATE_SOURCEMAP=false

# Treat lint warnings as build failures in CI.
CI=true
